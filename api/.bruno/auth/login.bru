meta {
  name: Login
  type: graphql
  seq: 4
}

post {
  url: {{graphqlUrl}}
  body: graphql
  auth: none
}

body:graphql {
  mutation Login($input: LoginDto!) {
    login(input: $input) {
      message
      mfa_required
      mfa_ticket
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "email": "user@example.com",
      "password": "strongpassword"
    }
  }
}
