meta {
  name: Doctor Signup
  type: graphql
  seq: 1
}

post {
  url: {{graphqlUrl}}
  body: graphql
  auth: none
}

body:graphql {
  mutation Signup($input: SignupDto!) {
    signup(input: $input)
  }
}

body:graphql:vars {
  {
    "input": {
      "email": "user@example.com",
      "password": "strongpassword",
      "full_name": "Dr. Jane Doe",
      "phone": "1234567890",
      "role": "DOCTOR"
    }
  }
}
