meta {
  name: Create Bulk Availability Slots
  type: graphql
  seq: 2
}

post {
  url: {{graphqlUrl}}
  body: graphql
  auth: none
}

body:graphql {
  mutation CreateBulkAvailabilitySlots($input: BulkCreateSlotsDto!) {
    createBulkAvailabilitySlots(input: $input)
  }
}

body:graphql:vars {
  {
    "input": {
      "start_time": "2026-10-25T09:00:00.000Z",
      "end_time": "2026-10-25T13:00:00.000Z",
      "slot_duration_minutes": 30
    }
  }
}
