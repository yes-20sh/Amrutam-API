meta {
  name: Create Availability Slot
  type: graphql
  seq: 1
}

post {
  url: {{graphqlUrl}}
  body: graphql
  auth: none
}

body:graphql {
  mutation CreateAvailabilitySlot($input: CreateAvailabilitySlotDto!) {
    createAvailabilitySlot(input: $input)
  }
}

body:graphql:vars {
  {
    "input": {
      "start_time": "2026-10-25T09:00:00.000Z",
      "end_time": "2026-10-25T09:30:00.000Z"
    }
  }
}
