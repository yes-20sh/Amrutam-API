meta {
  name: Get Doctor Availability
  type: graphql
  seq: 6
}

post {
  url: {{graphqlUrl}}
  body: graphql
  auth: none
}

body:graphql {
  query GetDoctorAvailability($doctorId: ID!, $fromDate: DateTime) {
    getDoctorAvailability(doctorId: $doctorId, fromDate: $fromDate) {
      slot_id
      doctor_id
      start_time
      end_time
      status
      created_at
      doctor {
        doctor_id
        specialization
        license_number
        qualification
        experience_years
        consultation_fee
      }
    }
  }
}

body:graphql:vars {
  {
    "doctorId": "00000000-0000-0000-0000-000000000000",
    "fromDate": "2026-10-25T00:00:00.000Z"
  }
}
