meta {
  name: Get Availability Slot By Id
  type: graphql
  seq: 7
}

post {
  url: {{graphqlUrl}}
  body: graphql
  auth: none
}

body:graphql {
  query GetAvailabilitySlotById($slotId: ID!) {
    getAvailabilitySlotById(slotId: $slotId) {
      slot_id
      doctor_id
      start_time
      end_time
      status
      created_at
      doctor {
        doctor_id
        specialization
        license_number
        qualification
        experience_years
        consultation_fee
      }
    }
  }
}

body:graphql:vars {
  {
    "slotId": "00000000-0000-0000-0000-000000000000"
  }
}
