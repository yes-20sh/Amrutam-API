meta {
  name: Get Payment By Id
  type: graphql
  seq: 4
}

post {
  url: {{graphqlUrl}}
  body: graphql
  auth: none
}

body:graphql {
  query GetPaymentById($paymentId: ID!) {
    getPaymentById(paymentId: $paymentId) {
      payment_id
      consultation_id
      amount
      currency
      payment_method
      payment_status
      transaction_reference
      paid_at
      created_at
      consultation {
        consultation_id
        scheduled_at
        consultation_type
        status
        patient {
          user_id
          email
          profile {
            full_name
            phone
          }
        }
        doctor {
          doctor_id
          specialization
          qualification
          consultation_fee
          user {
            profile {
              full_name
            }
          }
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "paymentId": "00000000-0000-0000-0000-000000000000"
  }
}
