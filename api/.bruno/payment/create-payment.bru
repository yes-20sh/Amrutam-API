meta {
  name: Create Payment
  type: graphql
  seq: 1
}

post {
  url: {{graphqlUrl}}
  body: graphql
  auth: none
}

body:graphql {
  mutation CreatePayment($input: CreatePaymentDto!) {
    createPayment(input: $input) {
      message
      payment_id
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "consultation_id": "00000000-0000-0000-0000-000000000000",
      "amount": "500.00",
      "currency": "INR",
      "payment_method": "UPI",
      "transaction_reference": "TXN_UPI_1234567890"
    }
  }
}
