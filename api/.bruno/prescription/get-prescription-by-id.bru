meta {
  name: Get Prescription By Id
  type: graphql
  seq: 3
}

post {
  url: {{graphqlUrl}}
  body: graphql
  auth: none
}

body:graphql {
  query GetPrescriptionById($prescriptionId: ID!) {
    getPrescriptionById(prescriptionId: $prescriptionId) {
      prescription_id
      consultation_id
      diagnosis
      medication_details {
        medicine_name
        dosage
        frequency
        duration
        instructions
      }
      instructions
      issued_at
      consultation {
        consultation_id
        scheduled_at
        status
        patient {
          user_id
          email
          profile {
            full_name
            phone
          }
        }
        doctor {
          doctor_id
          specialization
          license_number
          qualification
          user {
            profile {
              full_name
            }
          }
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "prescriptionId": "00000000-0000-0000-0000-000000000000"
  }
}
