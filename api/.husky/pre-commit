if [ "${SKIP_PRE_COMMIT:-0}" = "1" ]; then
  echo "Skipping all pre-commit hooks because SKIP_PRE_COMMIT=1"
  exit 0
fi

# Ensure commands run from api directory if triggered from repo root
if [ -d "api" ]; then
  cd api
fi

echo "Running pre-commit validation checks..."

# 1. ESLint / Oxlint Check on Staged Files
if [ "${SKIP_PRE_COMMIT_LINT:-0}" = "1" ]; then
  echo "⏭Skipping lint check (SKIP_PRE_COMMIT_LINT=1)"
else
  echo "[1/3] Running ESLint/Oxlint on staged files..."
  npx lint-staged || {
    echo "Lint check failed! Please fix ESLint/Oxlint errors before committing."
    exit 1
  }
fi

# 2. Build & TypeScript Compilation Check
if [ "${SKIP_PRE_COMMIT_BUILD:-0}" = "1" ]; then
  echo "⏭Skipping build check (SKIP_PRE_COMMIT_BUILD=1)"
else
  echo "[2/3] Checking project build (nest build)..."
  npm run build || {
    echo "Build check failed! Please resolve TypeScript/NestJS compilation errors before committing."
    exit 1
  }
fi

# 3. Dependency Security Audit
if [ "${SKIP_PRE_COMMIT_AUDIT:-0}" = "1" ]; then
  echo "⏭Skipping dependency audit (SKIP_PRE_COMMIT_AUDIT=1)"
else
  echo "[3/3] Checking dependencies for high/critical security vulnerabilities..."
  npm audit --audit-level=high || {
    echo " Security audit failed! High or critical vulnerabilities detected. Run 'npm audit' or 'npm audit fix' to resolve."
    exit 1
  }
fi

echo "All pre-commit checks (Lint, Build, Audit) passed successfully!"



